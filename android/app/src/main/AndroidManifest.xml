<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".StreamPlayerApplication"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_app_logo"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.StreamPlayer.Dark">

        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.StreamPlayer.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".activities.PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:supportsPictureInPicture="true" />

        <activity android:name=".activities.NetworkStreamActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.PlaylistActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.ChannelActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.SettingsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.NoticeActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.JoinActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".activities.AboutActivity" android:exported="false" android:screenOrientation="portrait" />
    </application>

</manifest>